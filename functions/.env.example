# ─────────────────────────────────────────────────────────────────────────────
# Shop API settings (not secret). Copy to functions/.env and fill in.
# Firebase loads this file into the functions when you deploy.
#
# The SECRETS are NOT set here. Set them once with:
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
#   firebase functions:secrets:set GITHUB_DISPATCH_TOKEN
#   firebase functions:secrets:set FEDEX_API_KEY
#   firebase functions:secrets:set FEDEX_SECRET_KEY
#   firebase functions:secrets:set FEDEX_ACCOUNT_NUMBER
# ─────────────────────────────────────────────────────────────────────────────

# "sandbox" while testing with Square's test account, "production" for real money
SQUARE_ENVIRONMENT=sandbox

# Nadine's Square location. Optional if her account has only one location.
SQUARE_LOCATION_ID=

# The live site, no trailing slash. Shoppers come back here after paying.
SITE_URL=https://crowandmoonenchantments.com

# Must match the webhook URL in the Square Developer Dashboard exactly
SQUARE_WEBHOOK_URL=https://crowandmoonenchantments.com/api/square-webhook

# owner/repo of the site's GitHub repository, for rebuilds when the catalog changes
GITHUB_REPO=

# Shown on Square's checkout page for questions about an order
SHOP_SUPPORT_EMAIL=crowandmoonenchantments@gmail.com

# ── Shipping (FedEx One Rate) ─────────────────────────────────────────────────
# Box sizes live in functions/shipping-rates.js. Prices come from FedEx once a
# day, using these settings.

# The ZIP Nadine ships from (required)
FEDEX_SHIP_FROM_ZIP=

# A ZIP far from Nadine, in FedEx's national band (zones 5-8). Prices are
# quoted to here so they cover shipping anywhere in the US.
FEDEX_RATE_TO_ZIP=90001

# Delivery speed: FEDEX_EXPRESS_SAVER (cheapest One Rate), FEDEX_2_DAY,
# FEDEX_2_DAY_AM, STANDARD_OVERNIGHT, PRIORITY_OVERNIGHT, FIRST_OVERNIGHT
FEDEX_SERVICE_TYPE=FEDEX_EXPRESS_SAVER

# DROPOFF_AT_FEDEX_LOCATION if she drops boxes off, USE_SCHEDULED_PICKUP if
# FedEx picks up on a regular schedule
FEDEX_PICKUP_TYPE=DROPOFF_AT_FEDEX_LOCATION

# "production" for real prices; "sandbox" only with FedEx test credentials
FEDEX_ENVIRONMENT=production
