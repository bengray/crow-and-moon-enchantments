# ─────────────────────────────────────────────────────────────────────────────
# Build settings for pulling the shop catalog from Square.
# Copy to .env (never commit .env) for local builds. In GitHub Actions these
# come from repository secrets instead; see SHOP-SETUP.md.
#
# With no SQUARE_ACCESS_TOKEN, the build uses placeholder products and the
# basket shows an "almost ready" message instead of checking out.
# ─────────────────────────────────────────────────────────────────────────────

SQUARE_ACCESS_TOKEN=
# "sandbox" or "production"; must match the token
SQUARE_ENVIRONMENT=sandbox
# Optional if the Square account has only one location
SQUARE_LOCATION_ID=
# Items in this Square category stay off the website (default "Not Online")
SHOP_HIDE_CATEGORY=Not Online
