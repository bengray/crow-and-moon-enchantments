# ─────────────────────────────────────────────────────────────────────────────
# Shop API settings (not secret). Copy to functions/.env and fill in.
# Firebase loads this file into the functions when you deploy.
#
# The three SECRETS are NOT set here. Set them once with:
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
#   firebase functions:secrets:set GITHUB_DISPATCH_TOKEN
# ─────────────────────────────────────────────────────────────────────────────

# "sandbox" while testing with Square's test account, "production" for real money
SQUARE_ENVIRONMENT=sandbox

# Nadine's Square location. Optional if her account has only one location.
SQUARE_LOCATION_ID=

# The live site, no trailing slash. Shoppers come back here after paying.
SITE_URL=https://www.crowandmoonenchantments.com

# Must match the webhook URL in the Square Developer Dashboard exactly
SQUARE_WEBHOOK_URL=https://www.crowandmoonenchantments.com/api/square-webhook

# owner/repo of the site's GitHub repository, for rebuilds when the catalog changes
GITHUB_REPO=

# Shown on Square's checkout page for questions about an order
SHOP_SUPPORT_EMAIL=crowandmoonenchantments@gmail.com

# Shipping isn't set here. Box sizes and prices live in functions/shipping-rates.js.
